DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-in-production-0123456789
DJANGO_DEBUG=1
DATABASE_URL=postgres://localhost/kupkop_dev
TEST_DATABASE_NAME=kupkop_test

# FCM push (US-P2) — leave blank for dev no-op; set both in production.
# FCM_PROJECT_ID is the Firebase project ID (e.g. kupkop-prod).
# FCM_CREDENTIALS_PATH is the filesystem path to the service-account JSON key
# downloaded from the Firebase console → Project settings → Service accounts.
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# S3 media storage (US-D2) — leave blank for dev stub (presigned URLs are placeholders).
# Provision two buckets in ap-southeast-1: one public (pet/listing/report photos) and one
# restricted (verification documents — no public read; reached only via signed_get_url).
# Apply backend/deploy/s3-lifecycle.json to the restricted bucket after creating it.
MEDIA_S3_BUCKET_PUBLIC=
MEDIA_S3_BUCKET_RESTRICTED=
